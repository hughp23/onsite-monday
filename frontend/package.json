{
  "name": "onsite-monday",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "concurrently --names \"expo,api\" --prefix-colors \"cyan,yellow\" \"npm run start\" \"dotnet run --project backend/src/OnsiteMonday.Api/OnsiteMonday.Api.csproj\"",
